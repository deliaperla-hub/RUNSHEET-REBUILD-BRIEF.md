# Vite reads these at BUILD time, so set them on the host before the first
# build. Leaving them unset is a supported configuration: the app then runs
# as a local-only, single-device product with no sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hosted checkout link for the Pro plan (Lemon Squeezy or Stripe).
VITE_CHECKOUT_URL=

# Subscription management / cancellation portal. Cancelling must be as easy
# as signing up, so this link is shown in the account panel on Pro.
VITE_BILLING_PORTAL_URL=
